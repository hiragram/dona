{
  "name": "@dona/updater",
  "version": "0.1.0",
  "private": true,
  "description": "Stable self-update controller for Dona",
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "bin": {
    "dona-updater": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js serve",
    "test": "tsx --test test/**/*.test.ts",
    "test:process-race": "tsx --test --test-name-pattern='ProcessRunner reports readiness|ProcessRunner waits for process-group|ProcessRunner prioritizes|timeout cleanup and signal exit' test/process.test.ts test/diagnostic-log.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
  }
}
