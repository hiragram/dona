# 接続するワークスペースの別名（小文字英数字・_・-）
# Tokenはこの別名ごとにmacOS Keychainへ保存される
SLACK_WORKSPACES=company,community

# Socket Mode以外のSlackイベント受信経路はサポートしない
SLACK_SOCKET_MODE_ENABLED=true

# Dispatcherと同じ値にする
# DONA_SOCKET_PATH=~/Library/Application Support/Dona/run/dispatcher.sock

# Adapter自身のローカルhealth check用UDS
# SLACK_HEALTH_SOCKET_PATH=~/Library/Application Support/Dona/run/slack-adapter.sock
# DONA_UPDATE_INTERNAL_TOKEN_PATH=~/Library/Application Support/Dona/update-control/dispatcher.token

# manifest.yamlのschemaとmetadata.message:read scopeを各Slack Appへ反映し、再認可した後だけtrueにする

# Dispatcher接続の初期値（接続500ms、全体2秒）
DONA_CONNECT_TIMEOUT_MS=500
DONA_REQUEST_TIMEOUT_MS=2000

# graceful shutdown時に処理中のDispatcher受付とACKを待つ時間
SLACK_SHUTDOWN_GRACE_MS=3000

# debug | info | warn | error
SLACK_LOG_LEVEL=info
